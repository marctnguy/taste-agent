# Taste Agent for Letterboxd
# Environment variable template
#
# Copy this file to `.env` for local development and replace
# placeholder values with your own credentials.
#
# NEVER commit `.env` or real API credentials to GitHub.


# --------------------------------------------------
# OpenAI
# --------------------------------------------------

OPENAI_API_KEY=your_openai_api_key_here


# --------------------------------------------------
# TMDB
# --------------------------------------------------
# Used for film metadata enrichment.
# The current n8n workflow authenticates to TMDB using
# an API Read Access Token / Bearer token.

TMDB_BEARER_TOKEN=your_tmdb_bearer_token_here


# --------------------------------------------------
# Google Books
# --------------------------------------------------
# Used for book metadata enrichment.
# Google Books uses an API key passed as a query parameter,
# not Bearer authentication.

GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here
